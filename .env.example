# Google Gemini API Key for AI-driven interaction derivation and post-audit evaluation
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model configuration (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Simulation Configuration Defaults
SIMULATION_KEY_DELAY=0.01
SIMULATION_NAVIGATION_DELAY=0.5
HEADLESS=false
MAX_STEPS=30
